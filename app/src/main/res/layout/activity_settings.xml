<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_cosmic_neon"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    tools:context=".SettingsActivity">

    <!-- Top Navigation Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_glass_icon_btn"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preferences &amp; Customization"
                android:textColor="#8B95B0"
                android:textSize="11.5sp" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- SECTION 0: VIP STORE & IN-APP PURCHASES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 VIP STORE &amp; IN-APP PURCHASES"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <!-- 1. Remove All Ads Card -->
                <LinearLayout
                    android:id="@+id/cardRemoveAds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_glass_card_active"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_glass_pill"
                        android:text="👑"
                        android:textSize="20sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRemoveAdsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REMOVE ALL ADS"
                            android:textColor="#FFD700"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRemoveAdsDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100% Ad-Free gaming forever"
                            android:textColor="#9EADC8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRemoveAdsPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_rounds"
                        android:text="$1.99"
                        android:textColor="#FFD700"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />
                </LinearLayout>

                <!-- 2. VIP Party Bundle Card -->
                <LinearLayout
                    android:id="@+id/cardVipBundle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_glass_card_selector"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_glass_pill"
                        android:text="🎉"
                        android:textSize="20sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvVipBundleTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VIP PARTY BUNDLE"
                            android:textColor="@color/accent_cyan"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Ads + All 10 Games Unlocked Forever"
                            android:textColor="#9EADC8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvVipBundlePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_rounds"
                        android:text="$3.99"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />
                </LinearLayout>

                <!-- 3. Tip / Buy a Coffee -->
                <LinearLayout
                    android:id="@+id/cardTipCoffee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_glass_card_selector"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_glass_pill"
                        android:text="☕"
                        android:textSize="20sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BUY US A COFFEE"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Support indie offline game development"
                            android:textColor="#9EADC8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTipPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_rounds"
                        android:text="$0.99"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />
                </LinearLayout>

                <!-- 4. Restore Purchases Button -->
                <Button
                    android:id="@+id/btnRestorePurchases"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_glass_card_selector"
                    android:minHeight="0dp"
                    android:text="🔄 RESTORE PURCHASES"
                    android:textColor="#8B95B0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- SECTION 1: AUDIO & HAPTICS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUDIO &amp; HAPTICS"
                android:textColor="@color/accent_cyan"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <!-- Sound Effects Switch -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔊 Sound Effects (SFX)"
                            android:textColor="@color/white"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Crisp audio clicks and match sounds"
                            android:textColor="#8B95B0"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:checked="true" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E193C"
                    android:layout_marginBottom="14dp" />

                <!-- Vibration / Haptics Switch -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📳 Haptic Vibration"
                            android:textColor="@color/white"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tactile vibrations on moves and goals"
                            android:textColor="#8B95B0"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchVibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:checked="true" />
                </RelativeLayout>
            </LinearLayout>

            <!-- SECTION 2: GAMEPLAY PREFERENCES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEFAULT GAMEPLAY SETTINGS"
                android:textColor="@color/accent_cyan"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <!-- Bot Difficulty Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 Default AI Bot Difficulty"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <!-- 3-Segment Difficulty Toggle Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_glass_pill"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnSettingsDiffEasy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="EASY 😌"
                        android:textColor="#7A8B9E"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSettingsDiffMedium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_diff_active_pink"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="MED 🤠"
                        android:textColor="@color/white"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSettingsDiffHard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="HARD 😈"
                        android:textColor="#7A8B9E"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSettingsDiffDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Medium: Balanced reaction &amp; clever tactics"
                    android:textColor="#8B95B0"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E193C"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp" />

                <!-- Match Rounds Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Default Match Format"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <!-- 3-Segment Format Toggle Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_glass_pill"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnSettingsRounds1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="1 ROUND ⚡"
                        android:textColor="#7A8B9E"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSettingsRounds3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_diff_active_pink"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="BEST OF 3 ⚡"
                        android:textColor="@color/white"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSettingsRounds5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="BEST OF 5 ⚡"
                        android:textColor="#7A8B9E"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION 3: CUP TOURNAMENTS & HISTORY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUP TOURNAMENT DATA"
                android:textColor="@color/accent_cyan"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <!-- View History & Replays Button -->
                <LinearLayout
                    android:id="@+id/btnSettingsViewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_glass_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📜 View Saved Cups &amp; Replays"
                        android:textColor="@color/accent_gold"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="➔"
                        android:textColor="@color/accent_gold"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Clear History Button -->
                <LinearLayout
                    android:id="@+id/btnSettingsClearHistory"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_glass_card_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🗑️ Clear Saved Tournaments"
                        android:textColor="@color/player_1_red"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear"
                        android:textColor="#88FF4D6D"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION 4: ACTIONS & ABOUT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APP &amp; SUPPORT"
                android:textColor="@color/accent_cyan"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <!-- Share App -->
                <Button
                    android:id="@+id/btnSettingsShare"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_glass_card_selector"
                    android:minHeight="0dp"
                    android:gravity="center"
                    android:text="📤 SHARE WITH FRIENDS"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <!-- Rate / Feedback Button -->
                <Button
                    android:id="@+id/btnSettingsFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_glass_card_selector"
                    android:minHeight="0dp"
                    android:gravity="center"
                    android:text="⭐ RATE &amp; FEEDBACK"
                    android:textColor="#FFD54F"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <!-- Reset Settings Button -->
                <Button
                    android:id="@+id/btnSettingsResetDefaults"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_glass_card_selector"
                    android:minHeight="0dp"
                    android:gravity="center"
                    android:text="🔄 RESET ALL SETTINGS"
                    android:textColor="#A0B0D0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- SECTION 5: BRANDING & 100% OFFLINE PRIVACY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="18dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 FUNTOZA"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1, 2, 3 &amp; 4 Player Offline Party Games"
                    android:textColor="#A0B0D0"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ 100% Offline • Zero Data Tracking • Completely Private"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Version 1.0.0 • Developed by AarIt Labs"
                    android:textColor="#6A7694"
                    android:textSize="10.5sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
