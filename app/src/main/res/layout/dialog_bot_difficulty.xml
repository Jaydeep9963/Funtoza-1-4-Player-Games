<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_dialog"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Top header with back / close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnDifficultyBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_glass_icon_btn"
                android:src="@drawable/ic_back"
                android:tint="@color/white"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDifficultyGameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 PLAYER VS BOT"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose your challenge level"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Bot Emoji Face in Frosted Glass -->
        <FrameLayout
            android:layout_width="114dp"
            android:layout_height="114dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center">

            <TextView
                android:id="@+id/tvBotEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="😊"
                android:textSize="56sp" />
        </FrameLayout>

        <!-- Difficulty Label with Neon Glow -->
        <TextView
            android:id="@+id/tvDifficultyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="EASY"
            android:textColor="#34C759"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- 3-Segment Glass Difficulty Slider / Toggle Bar -->
        <LinearLayout
            android:id="@+id/sliderContainer"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_progress_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btnDiffEasy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_diff_active_green"
                android:text="EASY"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDiffMedium"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="MED"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDiffHard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="HARD"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap to adjust difficulty"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Big Action Play Button -->
        <Button
            android:id="@+id/btnDifficultyPlay"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_diff_active_green"
            android:text="PLAY NOW"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
