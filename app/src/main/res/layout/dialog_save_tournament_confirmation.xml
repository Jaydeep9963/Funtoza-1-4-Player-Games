<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_dialog"
        android:padding="22dp"
        android:gravity="center_horizontal">

        <!-- Top Glowing Floppy Icon Circle -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_glass_pill">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="💾"
                android:textSize="28sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSaveTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="SAVE TOURNAMENT PROGRESS?"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tvSaveMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Round 2 of 5 in progress.\nSave now to resume or replay this cup anytime!"
            android:textColor="#9EADC8"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <!-- Primary Accent Button: SAVE & EXIT -->
            <Button
                android:id="@+id/btnSaveAndExit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_accent"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:text="SAVE PROGRESS &amp; EXIT ➔"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <!-- Secondary Actions Row: DISCARD vs KEEP PLAYING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnDiscardAndExit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_glass_card_selector"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="DISCARD"
                    android:textColor="@color/player_1_red"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCancelSave"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_glass_card_selector"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="KEEP PLAYING"
                    android:textColor="@color/white"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
