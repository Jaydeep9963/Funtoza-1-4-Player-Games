<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_cosmic_neon"
    android:padding="16dp"
    tools:context=".SelectPartyGamesActivity">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnPartySelectGamesBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_glass_icon_btn"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT 5 GAMES"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvSelectSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose 5 minigames for the tournament"
                android:textColor="#8B95B0"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Quick Action Bar & Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvCounterBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_glass_pill"
            android:text="SELECTED: 0/5"
            android:textColor="@color/neon_pink"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnQuickRandom"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_card_selector"
            android:text="🎲 RANDOM 5"
            android:textColor="@color/accent_gold"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnClearSelection"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_card_selector"
            android:text="CLEAR"
            android:textColor="@color/player_1_red"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- 5 Round Slots Preview Bar -->
    <LinearLayout
        android:id="@+id/layoutRoundSlotsBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:weightSum="5" />

    <!-- Scrollable Minigames List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/layoutGameItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp" />
    </ScrollView>

    <!-- Bottom Sticky Start Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnStartCustomTournament"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_accent"
            android:text="START TOURNAMENT (0/5) ➔"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:enabled="false"
            android:alpha="0.45" />
    </LinearLayout>

</LinearLayout>

