<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cosmic_neon">

    <!-- Ambient Cosmic Neon Glow Blobs in Background -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_glass_pill"
        android:alpha="0.16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="-70dp"
        android:layout_marginStart="-70dp" />

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_glass_pill"
        android:alpha="0.14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-90dp"
        android:layout_marginEnd="-90dp" />

    <!-- Phase 1: Animated Logo Hero Container -->
    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 3D Funtoza App Icon in Glowing Neon Halo Frame -->
        <FrameLayout
            android:id="@+id/iconBadge"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/bg_neon_app_icon_frame"
            android:padding="3.5dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="29dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">

                <ImageView
                    android:id="@+id/imgSplashAppIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/app_icon"
                    android:contentDescription="Funtoza 3D App Icon" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- 1 2 3 4 Neon colored digits -->
        <LinearLayout
            android:id="@+id/digitsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tvDigit1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/player_1_red"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDigit2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="@color/player_2_blue"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/tvDigit3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="@color/player_3_green"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/tvDigit4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="@color/player_4_yellow"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Brand Name with Neon Glow -->
        <TextView
            android:id="@+id/tvBrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FUNTOZA"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:shadowColor="@color/accent_cyan"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="16"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLAY TOGETHER. HAVE MORE FUN!"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:layout_marginTop="3dp" />

        <!-- 4-Color Neon Glass Underline Bar with Merged Rounded Endpoints -->
        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="5dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_bar_segment_left" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/player_2_blue" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/player_3_green" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_bar_segment_right" />
        </LinearLayout>
    </LinearLayout>

    <!-- Phase 2: Progress Bar Screen -->
    <LinearLayout
        android:id="@+id/phase2ProgressLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="72dp"
        android:alpha="0"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOADING PARTY ARENA..."
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:shadowColor="@color/accent_cyan"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="8"
            android:layout_marginBottom="14dp" />

        <!-- Glass Progress Track with Neon Gradient Fill -->
        <FrameLayout
            android:id="@+id/progressContainer"
            android:layout_width="270dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_glass_progress_track">

            <View
                android:id="@+id/viewProgressFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_progress_fill" />

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0%"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
