<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_cosmic_neon"
    android:padding="20dp"
    tools:context=".TournamentActivity">

    <!-- Header Glass Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_glass_pill"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvTourneyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 CUP TOURNAMENT"
            android:textColor="@color/accent_gold"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/tvRoundIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Round 1 of 5"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Podium Container -->
    <LinearLayout
        android:id="@+id/podiumContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="bottom|center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnTourneyExit"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_glass_card_selector"
            android:text="LEAVE CUP"
            android:textColor="@color/player_1_red"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNextMatch"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_accent"
            android:text="NEXT MATCH ➔"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
